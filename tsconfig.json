{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "lib": [ "ES2022", "DOM", "DOM.Iterable", "WebWorker" ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "node"
    },
    "include": [ "web_src/**/*" ]
}